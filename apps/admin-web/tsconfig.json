{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@university/ui": ["../../packages/ui/src"],
      "@university/hooks": ["../../packages/hooks/src"],
      "@university/utils": ["../../packages/utils/src"],
      "@university/types": ["../../packages/types/src"],
      "@university/api-client": ["../../packages/api-client/src"]
    }
  },
  "include": ["src"],
  "references": [
    { "path": "../../packages/ui" },
    { "path": "../../packages/hooks" },
    { "path": "../../packages/utils" },
    { "path": "../../packages/types" },
    { "path": "../../packages/api-client" }
  ]
}